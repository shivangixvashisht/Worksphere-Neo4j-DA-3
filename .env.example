# Copy this file to .env and fill in your own values. Never commit .env.

# --- Local Neo4j (Docker Compose or Neo4j tarball) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Choose your own password (minimum 8 characters). Docker Compose uses it on first start.
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# --- Neo4j Aura Free (alternative) ---
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<password shown once when the Aura instance is created>
# NEO4J_DATABASE=neo4j

# Express server port (the original WorkSphere used 5000; macOS AirPlay can occupy 5000 on newer macOS)
PORT=5000

# Custom Cypher console limits
CONSOLE_TIMEOUT_MS=5000
CONSOLE_MAX_ROWS=500

# Integration tests WIPE and re-seed the database they point at.
# Leave unset to reuse NEO4J_URI, or point at a separate throwaway instance.
# NEO4J_TEST_URI=bolt://localhost:7688
